{
    "name": "ts-test-helpers",
    "version": "0.1.3",
    "private": true,
    "description": "Internal test helper package for Money On Chain repos",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./hardhat.config.ts": "./hardhat.config.ts"
    },
    "files": [
        "dist",
        "README.md",
        "hardhat.config.ts",
        "hardhat.config.js",
        "hardhat.config.d.ts",
        "hardhat.config.js.map",
        "hardhat.config.d.ts.map"
    ],
    "scripts": {
        "clean": "hardhat clean && rm -rf dist artifacts cache",
        "compile": "hardhat compile",
        "build:local": "pnpm exec tsc -p tsconfig.json",
        "check": "pnpm exec tsc --noEmit -p tsconfig.json",
        "format": "pnpm exec prettier . --write",
        "format:check": "pnpm exec prettier . --check",
        "lint": "pnpm exec eslint . --max-warnings 0",
        "lint:fix": "pnpm exec eslint . --fix --max-warnings 0",
        "quality": "pnpm format:check && pnpm lint && pnpm check",
        "precommit": "lint-staged && pnpm check",
        "hooks:install": "husky",
        "test": "pnpm clean && pnpm compile && pnpm check && node --import tsx/esm --test \"test/**/*.test.ts\""
    },
    "lint-staged": {
        "*.{ts,tsx,js,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "*.{ts,tsx,js}": [
            "eslint --fix --max-warnings 0 --no-warn-ignored --ignore-pattern eslint.config.js --ignore-pattern hardhat.config.js --ignore-pattern hardhat.config.ts"
        ]
    },
    "dependencies": {
        "viem": "2.53.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
        "@openzeppelin/contracts": "4.9.3",
        "@types/node": "^26.0.1",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "globals": "^16.0.0",
        "hardhat": "3.9.0",
        "husky": "^9.0.0",
        "lint-staged": "^16.0.0",
        "prettier": "^3.0.0",
        "solc": "0.6.12",
        "tsx": "^4.22.4",
        "typechain": "^8.3.2",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.0.0"
    },
    "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
    "peerDependencies": {
        "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
        "hardhat": "3.9.0"
    },
    "peerDependenciesMeta": {
        "@nomicfoundation/hardhat-toolbox-viem": {
            "optional": true
        }
    }
}
